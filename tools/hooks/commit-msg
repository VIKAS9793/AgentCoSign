#!/usr/bin/env bash
# =============================================================================
# commit-msg — strip any Claude / Anthropic attribution from the commit message.
# Commits are authored as the owner alone: no Claude co-author trailer and no
# "Generated with Claude Code" line. This hook removes them before the commit
# finalizes (human co-authors are preserved), then blocks the commit when the
# subject is not a Conventional Commit or when a deploy, infrastructure, hook or
# guardrail change lacks the human sign-off tag. Commits that change product code
# (agentcosign/) must also carry these lines, checked by tools/guardrails.py:
#   Constraints: <rule ids>      the rules this change touches (or: none)
#   Evidence: tests/...py::test_name   tests that exist in the commit and prove it
#   Spec: <screen spec file>     when the merchant screen changes (spec updated)
#   README: updated | checked    README.md in the commit, or checked for stale facts
#
# Tracked source of truth. Activate with: bash tools/hooks/install.sh
# =============================================================================
set -uo pipefail

MSG_FILE="${1:-}"
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0

before="$(cat "$MSG_FILE")"

sed -i -E \
  -e '/^[[:space:]]*Co-[Aa]uthored-[Bb]y:.*([Cc]laude|[Aa]nthropic|anthropic\.com)/d' \
  -e '/[Gg]enerated with.*[Cc]laude[ -]?[Cc]ode/d' \
  -e '/🤖/d' \
  "$MSG_FILE"

after="$(cat "$MSG_FILE")"
if [ "$before" != "$after" ]; then
  echo "commit-msg: stripped a Claude/Anthropic attribution trailer (owner convention: no Claude co-author)." >&2
fi

# --- Validate what remains: Conventional Commit subject, and a sign-off tag for --
# deploy and infrastructure changes. Fails the commit.
PY=""
for c in ".venv/Scripts/python.exe" ".venv/bin/python"; do
  if [ -x "$c" ]; then PY="$c"; break; fi
done
[ -n "$PY" ] || PY="$(command -v python3 || command -v python || true)"
if [ -n "$PY" ] && [ -f tools/guardrails.py ]; then
  "$PY" tools/guardrails.py message "$MSG_FILE" || exit 1
fi
exit 0
