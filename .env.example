# ==============================================================================
# AgentCoSign — Environment Template (v1.1)  ->  copy to ".env" and edit
# ==============================================================================
# A fresh clone runs with NO .env at all (hermetic mode: recorded LLM answers and
# recorded PayPal sandbox evidence). Create .env only to switch on live
# dependencies. NEVER commit .env.
# ==============================================================================

# --- Runtime ------------------------------------------------------------------
# development | test | demo | production
# demo/production REQUIRE the three gateway secrets below (>= 32 chars).
AGENTCOSIGN_ENV=development
AGENTCOSIGN_HOST=127.0.0.1
AGENTCOSIGN_PORT=8000
AGENTCOSIGN_DEBUG=false

# true  = LLM answers come from the recorded cache (no Groq/NIM keys needed)
AGENTCOSIGN_REPLAY_MODE=true
# recorded = replay real sandbox evidence (no PayPal keys needed)
# sandbox  = call the live PayPal sandbox (needs the PayPal keys below)
AGENTCOSIGN_PAYPAL_EXECUTION=recorded

# --- Gateway credentials: three separate principals ---------------------------
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty in development => an ephemeral per-process secret is generated.
AGENTCOSIGN_AGENT_KEY=
AGENTCOSIGN_OPERATOR_KEY=
AGENTCOSIGN_AUDIT_KEY=

# --- PayPal Sandbox (pinned to sandbox; production is not selectable) ---------
# Sandbox UI login passwords do NOT belong here; use a password manager.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- LLM providers ------------------------------------------------------------
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=

# --- Storage ------------------------------------------------------------------
SQLITE_DB_PATH=data/agentcosign_audit.db
